{
  "name": "people-quality-report",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,cyan \"npm:dev -w @people-report/server\" \"npm:dev -w @people-report/web\"",
    "build": "npm run build -w @people-report/web",
    "start": "npm run start -w @people-report/server",
    "test": "npm run test -w @people-report/server && npm run test -w @people-report/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
